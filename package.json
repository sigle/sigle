{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "docker:dev:full": "docker compose --profile full up --build --watch",
    "docker:down": "docker compose --profile '*' down",
    "release": "pnpm changeset publish",
    "repos:sync": "./scripts/sync-repos.sh",
    "test": "turbo test",
    "prepare": "vp config && effect-tsgo patch --oxlint --tsrs",
    "version": "pnpm changeset version && pnpm vp fmt && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@cloudflare/oxlint-config": "0.2.0",
    "@effect/tsgo": "0.73.4",
    "railway": "3.17.0",
    "syncpack": "15.3.4",
    "turbo": "2.11.13",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.9.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.11.2"
}
