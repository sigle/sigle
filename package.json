{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "db:up": "docker compose up postgres -d --wait",
    "db:down": "docker compose stop postgres",
    "db:reset": "docker compose run --rm --build server pnpm prisma migrate reset --force",
    "db:migrate": "docker compose run --rm --build server pnpm prisma migrate dev",
    "db:studio": "docker compose --profile tools up --build studio",
    "docker:dev": "docker compose up --build --watch",
    "docker:dev:full": "docker compose --profile full up --build --watch",
    "docker:down": "docker compose --profile '*' down",
    "release": "pnpm changeset publish",
    "test": "turbo test",
    "prepare": "vp config",
    "version": "pnpm changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "syncpack": "15.3.2",
    "turbo": "2.10.9",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0"
}
