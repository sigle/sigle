{
  "$schema": "./node_modules/syncpack/schema.json",
  "semverGroups": [
    {
      "label": "pin all deps",
      "dependencyTypes": ["prod", "dev"],
      "range": ""
    }
  ],
  "versionGroups": [
    {
      "label": "@sigle/sdk stacks peer deps use a wider range than the pinned workspace versions",
      "packages": ["@sigle/sdk"],
      "dependencies": [
        "@stacks/common",
        "@stacks/encryption",
        "@stacks/transactions",
        "@stacks/network",
        "zod"
      ],
      "dependencyTypes": ["peer"],
      "isIgnored": true
    },
    {
      "label": "server Arweave tooling ahead until the client migrates",
      "packages": ["@sigle/server"],
      "dependencies": ["@ardrive/turbo-sdk", "multiformats"],
      "isIgnored": true
    }
  ]
}
