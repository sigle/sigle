{
  "$schema": "https://v2-11-2.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".astro/**"],
      "env": ["RAILWAY_GIT_COMMIT_SHA"],
      "passThroughEnv": ["POSTHOG_PERSONAL_API_KEY"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["CI", "E2E_SKIP_BUILD", "PLAYWRIGHT_*"]
    },
    "lint": {},
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
