{
  "$schema": "https://v2-11-2.turborepo.dev/schema.json",
  // Turbo never evicts by default. CI caps the size lower with
  // TURBO_CACHE_MAX_SIZE.
  "cacheMaxAge": "7d",
  "cacheMaxSize": "2GB",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // `next dev` writes to .next/dev, which is not part of the build.
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        ".astro/**"
      ],
      "env": ["RAILWAY_GIT_COMMIT_SHA"],
      "passThroughEnv": ["POSTHOG_PERSONAL_API_KEY"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["CI", "PLAYWRIGHT_*"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
