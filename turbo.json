{
  "$schema": "https://v2-11-2.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["db:generate", "^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".output/**",
        "dist/**",
        ".astro/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    }
  }
}
