{
  "name": "@sigle/sdk",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "codegen": "spec=\"$(mktemp -d)/openapi.json\" && pnpm --silent --filter @sigle/server openapi > \"$spec\" && openapi-typescript \"$spec\" --output ./src/__generated__/sigle-api-openapi.ts && vp fmt ./src/__generated__",
    "test": "vp test"
  },
  "dependencies": {
    "better-result": "3.0.1",
    "zod-validation-error": "5.0.0"
  },
  "devDependencies": {
    "@stacks/common": "7.7.0",
    "@stacks/encryption": "7.7.0",
    "@stacks/network": "7.7.0",
    "@stacks/transactions": "7.7.0",
    "@tsconfig/recommended": "1.0.14",
    "@types/node": "26.6.6",
    "openapi-typescript": "7.13.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@stacks/common": "^7.0.0",
    "@stacks/encryption": "^7.0.0",
    "@stacks/network": "^7.0.0",
    "@stacks/transactions": "^7.0.0",
    "zod": "^4.0.0"
  }
}
