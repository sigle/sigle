{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.sigle.io/schemas/posts/1.0.0.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://docs.sigle.io/schemas/posts/1.0.0.json"
    },
    "content": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The post id, the same for every revision of the post. Sigle uses it in the post URL."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Post title."
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000,
          "description": "Markdown content."
        },
        "excerpt": {
          "type": "string",
          "maxLength": 1000,
          "description": "A short plain text summary of the content, shown in post lists."
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "When the author published this revision, as an ISO 8601 date."
        },
        "previousVersion": {
          "description": "The Arweave transaction id of the revision this one replaces.",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "coverImage": {
          "description": "The cover image.",
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^([hH][tT][tT][pP]|[hH][tT][tT][pP][sS]|[iI][pP][fF][sS]|[aA][rR]):",
              "format": "uri",
              "description": "An http(s), ipfs:// or ar:// URL of the image."
            },
            "type": {
              "type": "string",
              "enum": ["image/gif", "image/jpeg", "image/png", "image/webp"],
              "description": "The MIME type of the image."
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "The width of the image in pixels."
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "The height of the image in pixels."
            },
            "alt": {
              "description": "The alt tag of the image for accessibility.",
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": ["url", "type", "width", "height"],
          "additionalProperties": false
        },
        "tags": {
          "description": "An arbitrary list of tags.",
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "An arbitrary tag."
          }
        },
        "language": {
          "description": "The language of the content, as a BCP 47 tag such as `en`.",
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "metaTitle": {
          "description": "The title for search engines and link previews, the title when omitted.",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "metaDescription": {
          "description": "The description for search engines and link previews, the excerpt when omitted.",
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "canonicalUri": {
          "description": "The http(s) URL of the original version of the post when it was first published elsewhere.",
          "type": "string",
          "maxLength": 200,
          "pattern": "^([hH][tT][tT][pP]|[hH][tT][tT][pP][sS]):",
          "format": "uri"
        },
        "contentWarning": {
          "type": "string",
          "enum": ["NSFW", "SENSITIVE", "SPOILER"],
          "description": "Specify a content warning."
        },
        "attributes": {
          "description": "Additional information that is not part of the standard.",
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "description": "The attribute's unique identifier."
              },
              "value": {
                "type": "string",
                "maxLength": 1000,
                "description": "The attribute's value."
              }
            },
            "required": ["key", "value"],
            "additionalProperties": false
          }
        }
      },
      "required": ["id", "title", "content", "excerpt", "publishedAt"],
      "additionalProperties": false
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "description": "A cryptographic signature of the `content` data."
    }
  },
  "required": ["$schema", "content"],
  "additionalProperties": false
}
